version: "3"

services:
  nginx:
    image: nginx:1.25
    container_name: nginx
    ports:
      - "{{ .cfg.Proxy.Port }}:80"
    networks:
      - {{ .cfg.NetworkName }}
    environment:
      - ACTIVE_APP_HOST={{ .cfg.ProjectSlug }}_green
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf
      - ./nginx/default.conf.template:/etc/nginx/templates/default.conf.template

networks:
  {{ .cfg.NetworkName }}:
    {{ if .cfg.NetworkExternal }}
    external: true
    name: {{ .cfg.NetworkName }}
    {{ else }}
    driver: bridge
    {{ end }}